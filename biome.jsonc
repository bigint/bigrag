{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "useButtonType": "error",
        "useKeyWithClickEvents": "error"
      },
      "complexity": {
        "noForEach": "error"
      },
      "correctness": {
        "noNestedComponentDefinitions": "error"
      },
      "style": {
        "noNegationElse": "error",
        "noNonNullAssertion": "error",
        "noUselessElse": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "files": {
    "includes": [
      "sdks/**/*.ts",
      "website/**/*.ts",
      "website/**/*.tsx",
      "website/**/*.mjs",
      "app/src/**/*.ts",
      "app/src/**/*.tsx",
      "!app/src/routeTree.gen.ts",
      "!**/.venv",
      "!**/.source",
      "!**/.next",
      "!**/dist"
    ]
  }
}
