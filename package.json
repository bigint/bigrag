{
  "name": "rag-computer",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "./dev.sh",
    "dev:website": "pnpm --filter @rag.computer/docs dev",
    "dev:app": "pnpm --filter @rag.computer/app dev",
    "build:app": "pnpm --filter @rag.computer/app build",
    "build:sdk": "pnpm --filter @rag.computer/client build",
    "build:website": "pnpm --filter @rag.computer/docs build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:api": "cd api && uv run ruff check . && uv run ruff format --check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.14",
      "uuid": "^14.0.0"
    }
  }
}
