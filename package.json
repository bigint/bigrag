{
  "name": "bigrag",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "./dev.sh",
    "dev:website": "pnpm --filter @bigrag/docs dev",
    "dev:app": "pnpm --filter @bigrag/app dev",
    "build:app": "pnpm --filter @bigrag/app build",
    "build:sdk": "pnpm --filter @bigrag/client build",
    "build:website": "pnpm --filter @bigrag/docs build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:api": "cd api && uv run ruff check . && uv run ruff format --check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.12",
      "uuid": "^14.0.0"
    }
  }
}
