{
  "name": "bigrag",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "./dev.sh",
    "dev:website": "pnpm --filter @bigrag/docs dev",
    "dev:app": "pnpm --filter @bigrag/app dev",
    "build:app": "pnpm --filter @bigrag/app build",
    "build:sdk": "pnpm --filter @bigrag/client build",
    "build:website": "pnpm --filter @bigrag/docs build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:api": "cd api && uv run ruff check . && uv run ruff format --check .",
    "check": "pnpm lint && pnpm lint:api && pnpm typecheck && pnpm build:app && pnpm build:sdk && pnpm build:website && cd api && uv run python -m compileall -q bigrag"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.26",
      "uuid": "^14.0.2"
    }
  }
}
