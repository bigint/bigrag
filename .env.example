# bigRAG Environment Variables
# Copy this file to .env and fill in the values.

# Set to false to disable authentication (for self-hosted/local use)
BIGRAG_AUTH_REQUIRED=true

# Required — encryption key for secrets at rest
BIGRAG_MASTER_KEY=

# Required — API key for your embedding provider (OpenAI or Cohere)
BIGRAG_EMBEDDING_API_KEY=

# Database
BIGRAG_DATABASE_URL=postgres://bigrag:bigrag@localhost:5432/bigrag

# Milvus
BIGRAG_MILVUS_URI=http://localhost:19530

# Redis
BIGRAG_REDIS_URL=redis://localhost:6379/0

# Server
BIGRAG_PORT=8080
BIGRAG_LOG_LEVEL=info

# Embedding defaults
BIGRAG_EMBEDDING_PROVIDER=openai
BIGRAG_EMBEDDING_MODEL=text-embedding-3-small
