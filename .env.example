# bigRAG Environment Variables
# Copy this file to .env and fill in the values.

# Required — API key for your embedding provider (OpenAI or Cohere)
BIGRAG_EMBEDDING_API_KEY=

# Deployment mode. `prod` enables startup safety checks; `dev` skips them.
BIGRAG_ENV=dev

# Database
BIGRAG_DATABASE_URL=postgres://bigrag:bigrag@localhost:5433/bigrag

# Milvus
BIGRAG_MILVUS_URI=http://localhost:19530

# Redis
BIGRAG_REDIS_URL=redis://localhost:6380/0

# Server
BIGRAG_PORT=6100
BIGRAG_LOG_LEVEL=info

# Fernet key used to encrypt provider secrets at rest. Required in production.
# Generate with:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
BIGRAG_MASTER_KEY=

# Auth — admin accounts are created via the Studio UI (/setup) on first run.
# API keys for external clients are then issued from the Studio.
# In production, set SECURE=true when serving the Studio over HTTPS.
BIGRAG_SESSION_COOKIE_SECURE=false
# CORS origins for the Studio UI (comma-separated), e.g. https://studio.example.com
# BIGRAG_CORS_ORIGINS=http://localhost:3100

# Embedding defaults
BIGRAG_EMBEDDING_PROVIDER=openai
BIGRAG_EMBEDDING_MODEL=text-embedding-3-small

# Storage
# Local filesystem by default. Set to `s3` to use an S3-compatible backend.
BIGRAG_STORAGE_BACKEND=local
BIGRAG_UPLOAD_DIR=./data/uploads
# BIGRAG_S3_BUCKET=
# BIGRAG_S3_ENDPOINT_URL=
# BIGRAG_S3_REGION=us-east-1
# BIGRAG_S3_ACCESS_KEY=
# BIGRAG_S3_SECRET_KEY=

# Optional tunables (defaults are sensible for most deployments)
# BIGRAG_DB_POOL_MIN=5
# BIGRAG_DB_POOL_MAX=50
# BIGRAG_CHUNK_SIZE=512
# BIGRAG_CHUNK_OVERLAP=50
# BIGRAG_MAX_UPLOAD_SIZE_MB=1024
# BIGRAG_INGESTION_WORKERS=4
# BIGRAG_INGESTION_BATCH_SIZE=128
# BIGRAG_MILVUS_NPROBE=32
