# rag.computer environment variables
# Copy this file to .env and fill only the values you need.
# Defaults live in api/rag_computer/config.py; avoid setting default-only values in deploy platforms.

# Required for provider-backed embedding.
RAG_COMPUTER_EMBEDDING_API_KEY=

# Required in production. Generate with:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
RAG_COMPUTER_MASTER_KEY=

# Production mode enables startup safety checks.
# RAG_COMPUTER_ENV=prod

# Set for browser clients such as the admin UI.
# RAG_COMPUTER_CORS_ORIGINS=["https://admin.example.com"]
# RAG_COMPUTER_SESSION_COOKIE_SECURE=true

# Override only when the backing services are not running on local defaults.
# RAG_COMPUTER_DATABASE_URL=postgres://rag_computer:rag_computer@localhost:5432/rag_computer?sslmode=disable
# RAG_COMPUTER_QDRANT_URL=http://localhost:6333
# RAG_COMPUTER_REDIS_URL=redis://localhost:6379/0

# Set only for Qdrant Cloud or another protected Qdrant instance.
# RAG_COMPUTER_QDRANT_API_KEY=

# Set only when local uploads should live outside ./data/uploads.
# RAG_COMPUTER_UPLOAD_DIR=/data/uploads

# OCR for scanned PDFs is enabled by default. Uncomment only to disable it.
# RAG_COMPUTER_CONVERSION_PDF_OCR_ENABLED=false

# Optional proxy trust list for audit logs and IP rate limits.
# RAG_COMPUTER_TRUSTED_PROXIES=["10.0.0.0/8"]
