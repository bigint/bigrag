BIGRAG_ENV=prod
BIGRAG_LOG_LEVEL=info
BIGRAG_LOG_FORMAT=json
BIGRAG_DATABASE_URL=${{Postgres.DATABASE_URL}}
BIGRAG_REDIS_URL=${{Redis.REDIS_URL}}
BIGRAG_MASTER_KEY=
BIGRAG_MASTER_KEY_PREVIOUS=[]
BIGRAG_ALLOW_PUBLIC_BIND_IN_PROD=true
BIGRAG_SESSION_COOKIE_SECURE=true
BIGRAG_SESSION_COOKIE_SAMESITE=none
BIGRAG_CORS_ORIGINS=["https://${{App.RAILWAY_PUBLIC_DOMAIN}}"]
BIGRAG_TRUSTED_PROXIES=[]
BIGRAG_UPLOAD_DIR=/tmp/bigrag/uploads
BIGRAG_STORAGE_BACKEND=s3
BIGRAG_STORAGE_S3_BUCKET=${{Uploads.BUCKET}}
BIGRAG_STORAGE_S3_ENDPOINT_URL=${{Uploads.ENDPOINT}}
BIGRAG_STORAGE_S3_REGION=${{Uploads.REGION}}
BIGRAG_STORAGE_S3_PREFIX=uploads
BIGRAG_STORAGE_S3_ACCESS_KEY_ID=${{Uploads.ACCESS_KEY_ID}}
BIGRAG_STORAGE_S3_SECRET_ACCESS_KEY=${{Uploads.SECRET_ACCESS_KEY}}
BIGRAG_STORAGE_S3_FORCE_PATH_STYLE=false
BIGRAG_TURBOPUFFER_API_KEY=
BIGRAG_TURBOPUFFER_REGION=aws-us-east-1
BIGRAG_TURBOPUFFER_NAMESPACE_PREFIX=bigrag_
BIGRAG_TURBOPUFFER_BASE_URL=
BIGRAG_EMBEDDING_API_KEY=
BIGRAG_WORKER_HEALTHCHECK_KEY=bigrag:dramatiq:worker:heartbeat
