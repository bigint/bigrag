{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "/api/Dockerfile",
    "watchPatterns": [
      "/api/**",
      "/railway/worker.json",
      "/railway/variables/worker.env"
    ]
  },
  "deploy": {
    "startCommand": "bigrag-worker --processes 1 --threads 8",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "drainingSeconds": 30
  }
}
