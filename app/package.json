{
  "name": "@bigrag/app",
  "version": "2026.4.30",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "pnpm run routes:generate && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "routes:generate": "tsr generate",
    "start": "serve dist --single --listen tcp://0.0.0.0:${PORT:-3000}",
    "typecheck": "pnpm run routes:generate && tsc --noEmit",
    "lint": "biome check --write src/",
    "test": "vitest run",
    "coverage": "vitest run --coverage --coverage.all=true --coverage.include='src/**/*.{ts,tsx}' --coverage.exclude='src/routeTree.gen.ts'"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@bigrag/client": "workspace:*",
    "@fontsource-variable/outfit": "^5.2.8",
    "@tanstack/react-form": "^1.32.0",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-router-devtools": "^1.167.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "ky": "^2.0.2",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "serve": "^14.2.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/router-cli": "^1.167.0",
    "@tanstack/router-plugin": "^1.168.0",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.6",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  }
}
